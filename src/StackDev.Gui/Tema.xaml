<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Paleta oscura -->
  <SolidColorBrush x:Key="BgBrush" Color="#0C0D0F" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#09090B" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#16171A" />
  <SolidColorBrush x:Key="Surface2Brush" Color="#1E2024" />
  <SolidColorBrush x:Key="LineBrush" Color="#26282D" />
  <SolidColorBrush x:Key="TextBrush" Color="#E8EAED" />
  <SolidColorBrush x:Key="MutedBrush" Color="#8A8F98" />
  <SolidColorBrush x:Key="AccentBrush" Color="#6EE787" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#8CF0A1" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#12261A" />
  <!-- Texto sobre el acento (oscuro, para que se lea sobre verde o ámbar) -->
  <SolidColorBrush x:Key="AccentOnBrush" Color="#07210E" />
  <!-- Relieve sutil de los botones: un poco más claro arriba -->
  <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#26282D" Offset="0" />
    <GradientStop Color="#1E2024" Offset="1" />
  </LinearGradientBrush>
  <!-- El degradado del acento (verde terminal; ámbar en el tema alterno) -->
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#7AEC92" Offset="0" />
    <GradientStop Color="#5BD878" Offset="1" />
  </LinearGradientBrush>
  <!-- Superficie de las tarjetas: un poco más clara arriba, como en relieve -->
  <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1A1C20" Offset="0" />
    <GradientStop Color="#16171A" Offset="1" />
  </LinearGradientBrush>
  <!-- Cuadrícula de puntos del fondo (lienzo de ingeniería) -->
  <DrawingBrush x:Key="DotGridBrush" TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute" Viewbox="0,0,22,22" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="#14FFFFFF">
        <GeometryDrawing.Geometry>
          <EllipseGeometry Center="1,1" RadiusX="0.7" RadiusY="0.7" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <SolidColorBrush x:Key="OkBrush" Color="#22C55E" />
  <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B" />
  <SolidColorBrush x:Key="ErrBrush" Color="#EF4444" />

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Tarjeta -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardGradient}" />
    <Setter Property="BorderBrush" Value="#0DFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.3" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botón base -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource ButtonGradient}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Opacity" Value="0.88" />
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Fondo" Property="Opacity" Value="0.75" />
              <Setter TargetName="Fondo" Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentOnBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,9" />
  </Style>

  <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#3A1D22" />
    <Setter Property="BorderBrush" Value="#6B2A33" />
    <Setter Property="Foreground" Value="#FCA5A5" />
    <Setter Property="Padding" Value="16,9" />
  </Style>

  <Style x:Key="BtnChip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>


  <!-- Ficha con un glifo (cabecera de grupo) -->
  <Style x:Key="FichaGlifo" TargetType="Border">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Background" Value="#0F1012" />
    <Setter Property="BorderBrush" Value="#14FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Margin" Value="0,0,14,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Glifo" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="GlifoBtn" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Etiqueta" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>

  <!-- Chip del proyecto en la barra superior (~/proyecto on rama*) -->
  <Style x:Key="BtnChipProyecto" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo" Background="#141517" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,5">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botón de icono plano (estrella de favorito, barra superior) -->
  <Style x:Key="BtnIcono" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="5" Padding="8,4">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Surface2Brush}" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botones de la ventana (minimizar, maximizar, cerrar) -->
  <Style x:Key="BtnVentana" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Surface2Brush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BtnCerrarVentana" TargetType="Button" BasedOn="{StaticResource BtnVentana}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo" Background="{TemplateBinding Background}">
            <ContentPresenter x:Name="Icono" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="#E81123" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Navegación lateral -->
  <Style x:Key="NavButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Fondo" Background="Transparent" CornerRadius="9" Padding="14,9">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <Border x:Name="Marca" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,7"
                    Background="{StaticResource AccentGradient}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Surface2Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{StaticResource AccentSoftBrush}" />
              <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Opción marcable (condiciones del dispositivo) -->
  <Style x:Key="ChipToggle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Fondo" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="14,6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{StaticResource AccentGradient}" />
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter Property="Foreground" Value="{StaticResource AccentOnBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Cuadro de texto -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="5">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lista -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Fondo" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="#26282D" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{StaticResource AccentBrush}" />
              <Setter Property="Foreground" Value="{StaticResource AccentOnBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Barra de desplazamiento fina -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#3A4150" CornerRadius="4" Margin="2" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Background="#3A4150" CornerRadius="4" Margin="2" />
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
