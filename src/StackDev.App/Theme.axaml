<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The "Forja" dark palette, shared with the Windows window. -->
  <Styles.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#0C0D0F" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#16171A" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#1E2024" />
    <SolidColorBrush x:Key="LineBrush" Color="#26282D" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8EAED" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8A8F98" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6EE787" />
    <SolidColorBrush x:Key="AccentOnBrush" Color="#07210E" />
    <SolidColorBrush x:Key="OkBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="ErrBrush" Color="#EF4444" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- One size scale for buttons: normal, and the compact one used inside cards. -->
  <Style Selector="Button">
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.sm">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentOnBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#8CF0A1" />
    <Setter Property="Foreground" Value="{StaticResource AccentOnBrush}" />
  </Style>

  <!-- :is(...) because the cards are a Border subclass and a plain type selector matches the exact type only. -->
  <Style Selector=":is(Border).card">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,0,16,16" />
    <Setter Property="Width" Value="400" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
</Styles>
