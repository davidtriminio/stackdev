<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>StackDev.Cli</RootNamespace>
    <AssemblyName>stackdev</AssemblyName>

    <!-- dotnet global tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>stackdev</ToolCommandName>
    <PackageId>stackdev</PackageId>
    <Version>0.1.0</Version>
    <Description>Herramienta de desarrollo local: API .NET + web Angular + Flutter + Postgres en Docker.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../nupkg</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
    <ProjectReference Include="..\StackDev.Core\StackDev.Core.csproj" />
  </ItemGroup>
</Project>
